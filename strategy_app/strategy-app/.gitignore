# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma sqlite (ローカルDB)
/prisma/*.db
/prisma/*.db-journal

# リポジトリ直下の .gitignore に Python 用の `lib/` 除外があり、
# Next.js の src/lib（prisma シングルトン等の核心ファイル）が巻き込まれるため打ち消す。
!src/lib/
!src/lib/**

# DB migration dump (contains data)
/prisma/migration-data.json
